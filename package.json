{
  "name": "tx-family-law-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI family-law information agent for the Texas family court system, scoped to Spring, TX (Harris and Montgomery counties).",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "txfam": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "start": "node --experimental-strip-types src/cli.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
