# Copy to .env and adjust. Read by docker-compose and by scripts/*.sh.

# ---- Weights (ungated GGUF re-quant of orcarouter/Qwen3.8-27B-Uncensored) ----
HF_REPO=JonathanColetti/Qwen3.8-27B-Uncensored-GGUF
# Fused file: MTP draft head inline. Q4_K_M fits a 24 GB GPU with 8k ctx.
MODEL_FILE=Qwen3.8-27B-Uncensored-Q4_K_M.gguf
# Vision projector. Leave empty to serve text-only.
MMPROJ_FILE=mmproj-Qwen3.8-27B-Uncensored-F16.gguf
MODELS_DIR=./models

# ---- llama-server ----
LLAMA_HOST=0.0.0.0
LLAMA_PORT=8080
LLAMA_CTX_SIZE=8192
LLAMA_N_GPU_LAYERS=99
LLAMA_PARALLEL=1
# MTP speculative decoding. n_max=2 is the throughput sweet spot on the
# author's H200 sweep for prose/chat; 1 for code. Set SPEC_TYPE=none to disable.
LLAMA_SPEC_TYPE=draft-mtp
LLAMA_SPEC_DRAFT_N_MAX=2
# Optional bearer token enforced by llama-server. Empty = no auth.
LLAMA_API_KEY=
# Model id reported by /v1/models and required in client requests.
LLAMA_ALIAS=qwen3.8-27b-uncensored

# ---- Client ----
QWEN_BASE_URL=http://localhost:8080/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-27b-uncensored
QWEN_TIMEOUT_S=300
